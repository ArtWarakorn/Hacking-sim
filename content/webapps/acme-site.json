          "body": ""
        },
        {
          "when": {
            "method": "POST"
          },
          "status": 200,
          "body": "<html><body><p>Invalid username or password.</p></body></html>\n"
        },
        {
          "status": 200,
          "body": "<html><body>\n<h1>Customer login</h1>\n<form method=\"POST\" action=\"/login\">\n<input name=\"user\"><input name=\"pass\" type=\"password\"><button>Login</button>\n</form>\n</body></html>\n"
        }
      ]
    },
